Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Floor Grid
      Cell Size: 0.25
      Plane Cell Count: 40
      Color: 125; 125; 125
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Room and Table
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odor_sim/room_visualization
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Wind and Labels
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odor_sim/wind_visualization
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Gas Sources
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gaden/source_visualization
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Colored Gas Filaments
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gaden/filament_visualization
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 2.0
        Y: 3.0
        Z: 0.8
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Yaw: 4.7
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1450
  X: 50
  Y: 40
